                "visualEditor": {
                  "code": "const axisOrder = [\"temperature\", \"humidity\", \"pressure\", \"illuminance\"];\n\nconst ranges = {\n  temperature: { label: \"Temperature °C\", min: -20, max: 35, unit: \"°C\" },\n  humidity: { label: \"Humidity %\", min: 0, max: 100, unit: \"%\" },\n  pressure: { label: \"Pressure hPa\", min: 980, max: 1040, unit: \"hPa\" },\n  illuminance: { label: \"Illuminance lx\", min: 0, max: 50000, unit: \"lx\" },\n};\n\nconst groupedRaw = {};\n\nfor (const s of context.panel.data.series) {\n  const valueField = s.fields.find((f) => f.type === \"number\");\n  if (!valueField) continue;\n\n  const labels = valueField.labels || {};\n  const stat = labels.stat;\n  const field = labels.field;\n\n  if (!stat || !field) continue;\n  if (!axisOrder.includes(field)) continue;\n\n  if (!groupedRaw[stat]) {\n    groupedRaw[stat] = {};\n  }\n\n  const values = valueField.values;\n  const idx = (values.length ?? 0) - 1;\n  const value = values.get ? values.get(idx) : values[idx];\n\n  if (value == null || Number.isNaN(Number(value))) continue;\n\n  groupedRaw[stat][field] = Number(value);\n}\n\nfunction normalize(field, value) {\n  const cfg = ranges[field];\n  if (!cfg || value == null || Number.isNaN(value)) return 0;\n\n  if (field === \"illuminance\") {\n    const maxLux = cfg.max;\n    const safeValue = Math.max(0, value);\n    const pct = (Math.log10(safeValue + 1) / Math.log10(maxLux + 1)) * 100;\n    return Math.max(0, Math.min(100, pct));\n  }\n\n  const span = cfg.max - cfg.min;\n  if (span <= 0) return 0;\n\n  const pct = ((value - cfg.min) / span) * 100;\n  return Math.max(0, Math.min(100, pct));\n}\n\nconst seriesOrder = [\n  { key: \"day_min\", name: \"Day Min\", symbol: \"rect\" },\n  { key: \"day_mean\", name: \"Day Mean\", symbol: \"circle\" },\n  { key: \"day_median\", name: \"Day Median\", symbol: \"diamond\" },\n  { key: \"day_max\", name: \"Day Max\", symbol: \"triangle\" },\n];\n\nreturn {\n  backgroundColor: \"transparent\",\n  tooltip: {\n    trigger: \"item\",\n    formatter: function (params) {\n      const raw = params.data.raw || {};\n      return [\n        `<b>${params.name}</b>`,\n        `Temperature: ${raw.temperature?.toFixed(2) ?? \"-\"} °C`,\n        `Humidity: ${raw.humidity?.toFixed(2) ?? \"-\"} %`,\n        `Pressure: ${raw.pressure?.toFixed(2) ?? \"-\"} hPa`,\n        `Illuminance: ${raw.illuminance?.toFixed(0) ?? \"-\"} lx`,\n      ].join(\"<br/>\");\n    },\n  },\n  legend: {\n    bottom: 10,\n  },\n  radar: {\n    radius: \"80%\",\n    splitNumber: 5,\n    indicator: axisOrder.map((field) => ({\n      name: ranges[field].label,\n      min: 0,\n      max: 100,\n    })),\n  },\n  series: [\n    {\n      type: \"radar\",\n      data: seriesOrder\n        .filter(({ key }) => groupedRaw[key])\n        .map(({ key, name, symbol }) => {\n          const raw = groupedRaw[key];\n          return {\n            name,\n            symbol,\n            symbolSize: 8,\n            raw,\n            value: axisOrder.map((field) => normalize(field, raw[field] ?? NaN)),\n            lineStyle: { width: key === \"day_mean\" ? 3 : 2 },\n            areaStyle: { opacity: 0 },\n          };\n        }),\n    },\n  ],\n};",
