                        "expr": "label_replace(\n  min_over_time(\n    esp32_sensor_min_60s{\n      job=~\"$job\",  device=~\"$device\", room=~\"$room\",  instance=~\"$instance\",\n      placement=\"outdoor\",\n      sensor=\"bme280\",\n      field=~\"temperature|humidity|pressure\"\n    }[$__range]\n  ),\n  \"stat\", \"day_min\", \"__name__\", \".*\"\n)\nor\nlabel_replace(\n  avg_over_time(\n    esp32_sensor_mean_60s{\n      job=~\"$job\",  device=~\"$device\", room=~\"$room\",  instance=~\"$instance\",\n      placement=\"outdoor\",\n      sensor=\"bme280\",\n      field=~\"temperature|humidity|pressure\"\n    }[$__range]\n  ),\n  \"stat\", \"day_mean\", \"__name__\", \".*\"\n)\nor\nlabel_replace(\n  max_over_time(\n    esp32_sensor_max_60s{\n      job=~\"$job\",  device=~\"$device\", room=~\"$room\",  instance=~\"$instance\",\n      placement=\"outdoor\",\n      sensor=\"bme280\",\n      field=~\"temperature|humidity|pressure\"\n    }[$__range]\n  ),\n  \"stat\", \"day_max\", \"__name__\", \".*\"\n)",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "timeFrom": "now/d",
                "timeShift": "0h"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "volkovlabs-echarts-panel",
            "version": "7.2.4",
            "spec": {
              "options": {
                "baidu": {
                  "callback": "bmapReady",
                  "key": ""
                },
                "editor": {
                  "format": "auto"
                },
                "editorMode": "visual",
                "gaode": {
                  "key": "",
                  "plugin": "AMap.Scale,AMap.ToolBar"
                },
                "getOption": "const series = context.panel.data.series.map((s) => {\n  const sData = s.fields.find((f) => f.type === 'number').values.buffer || s.fields.find((f) => f.type === 'number').values;\n  const sTime = s.fields.find((f) => f.type === 'time').values.buffer || s.fields.find((f) => f.type === 'time').values;\n  \n  return {\n    name: s.refId,\n    type: 'line',\n    showSymbol: false,\n    areaStyle: {\n      opacity: 0.1,\n    },\n    lineStyle: {\n      width: 1,\n    },\n    data: sData.map((d, i) => [sTime[i], d.toFixed(2)]),\n  };\n});\n\n/**\n * Enable Data Zoom by default\n */\nsetTimeout(() => context.panel.chart.dispatchAction({\n  type: 'takeGlobalCursor',\n  key: 'dataZoomSelect',\n  dataZoomSelectActive: true,\n}), 500);\n\n/**\n * Update Time Range on Zoom\n */\ncontext.panel.chart.on('datazoom', function (params) {\n  const startValue = params.batch[0]?.startValue;\n  const endValue = params.batch[0]?.endValue;\n  locationService.partial({ from: startValue, to: endValue });\n});\n\nreturn {\n  backgroundColor: 'transparent',\n  tooltip: {\n    trigger: 'axis',\n  },\n  legend: {\n    left: '0',\n    bottom: '0',\n    data: context.panel.data.series.map((s) => s.refId),\n    textStyle: {\n      color: 'rgba(128, 128, 128, .9)',\n    },\n  },\n  toolbox: {\n    feature: {\n      dataZoom: {\n        yAxisIndex: 'none',\n        icon: {\n          zoom: 'path://',\n          back: 'path://',\n        },\n      },\n      saveAsImage: {},\n    }\n  },\n  xAxis: {\n    type: 'time',\n  },\n  yAxis: {\n    type: 'value',\n    min: 'dataMin',\n  },\n  grid: {\n    left: '2%',\n    right: '2%',\n    top: '2%',\n    bottom: 24,\n    containLabel: true,\n  },\n  series,\n};",
                "google": {
                  "callback": "gmapReady",
                  "key": ""
                },
                "map": "none",
                "renderer": "canvas",
                "themeEditor": {
                  "config": "{}",
                  "name": "default"
                },
                "visualEditor": {
                  "code": "const axisOrder = [\"temperature\", \"humidity\", \"pressure\"];\n\nconst ranges = {\n  temperature: { label: \"Temperature °C\", min: -20, max: 35, unit: \"°C\" },\n  humidity: { label: \"Humidity %\", min: 0, max: 100, unit: \"%\" },\n  pressure: { label: \"Pressure hPa\", min: 980, max: 1040, unit: \"hPa\" },\n};\n\nconst groupedRaw = {};\n\nfor (const s of context.panel.data.series) {\n  const valueField = s.fields.find((f) => f.type === \"number\");\n  if (!valueField) continue;\n\n  const labels = valueField.labels || {};\n  const stat = labels.stat;\n  const field = labels.field;\n\n  if (!stat || !field) continue;\n  if (!axisOrder.includes(field)) continue;\n\n  if (!groupedRaw[stat]) {\n    groupedRaw[stat] = {};\n  }\n\n  const values = valueField.values;\n  const idx = (values.length ?? 0) - 1;\n  const value = values.get ? values.get(idx) : values[idx];\n\n  if (value == null || Number.isNaN(Number(value))) continue;\n\n  groupedRaw[stat][field] = Number(value);\n}\n\nfunction normalize(field, value) {\n  const cfg = ranges[field];\n  if (!cfg) return 0;\n\n  const span = cfg.max - cfg.min;\n  if (span <= 0) return 0;\n\n  const pct = ((value - cfg.min) / span) * 100;\n  return Math.max(0, Math.min(100, pct));\n}\n\nconst seriesOrder = [\n  { key: \"day_min\", name: \"Day Min\", symbol: \"rect\" },\n  { key: \"day_mean\", name: \"Day Mean\", symbol: \"circle\" },\n  { key: \"day_max\", name: \"Day Max\", symbol: \"triangle\" },\n];\n\nreturn {\n  backgroundColor: \"transparent\",\n  tooltip: {\n    trigger: \"item\",\n    formatter: function (params) {\n      const raw = params.data.raw || {};\n      return [\n        `<b>${params.name}</b>`,\n        `Temperature: ${raw.temperature?.toFixed(2) ?? \"-\"} °C`,\n        `Humidity: ${raw.humidity?.toFixed(2) ?? \"-\"} %`,\n        `Pressure: ${raw.pressure?.toFixed(2) ?? \"-\"} hPa`,\n      ].join(\"<br/>\");\n    },\n  },\n  legend: {\n    bottom: 10,\n  },\n  radar: {\n    radius: \"90%\",\n    splitNumber: 5,\n    indicator: axisOrder.map((field) => ({\n      name: ranges[field].label,\n      min: 0,\n      max: 100,\n    })),\n  },\n  series: [\n    {\n      type: \"radar\",\n      data: seriesOrder\n        .filter(({ key }) => groupedRaw[key])\n        .map(({ key, name, symbol }) => {\n          const raw = groupedRaw[key];\n          return {\n            name,\n            symbol,\n            symbolSize: 8,\n            raw,\n            value: axisOrder.map((field) => normalize(field, raw[field] ?? NaN)),\n            lineStyle: { width: 2 },\n            areaStyle: { opacity: 0 },\n          };\n        }),\n    },\n  ],\n};",
                  "dataset": [],
                  "series": []
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
